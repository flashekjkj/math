# Python and local tooling
__pycache__/
*.py[cod]
.cache/
.vscode/
.venv/
*.egg-info/
build/
dist/

# Local secrets
.env
.env.*
!.env.example
*.pem
*.key

# Downloaded models and training checkpoints
/models/
/runs/

